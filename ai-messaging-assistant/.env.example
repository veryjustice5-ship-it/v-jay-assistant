# Flask Application Environment Configuration
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-token
DATABASE_PATH=messaging_assistant.db

# Automation Mode: 'draft_only', 'approval_required', or 'restricted_auto'
AUTOMATION_MODE=approval_required

# Communication Style: 'concise', 'casual', 'professional', or 'direct'
COMMUNICATION_STYLE=concise

# User identity for personalized responses
USER_NAME=Alex
